{
  "name": "@uniconn/node",
  "version": "0.1.0",
  "description": "uniconn Node.js adapters — TCP, WebSocket (ws), KCP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./p2p": "./dist/p2p.js",
    "./secure/identity": "./dist/secure/identity.js",
    "./tcp/dialer": "./dist/tcp/dialer.js",
    "./*": "./*"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "node ../scripts/build.mjs core node",
    "test": "node --test dist/multi/*.test.js dist/secure/*.test.js dist/test/secure*.test.js dist/test/p2p*.test.js dist/test/transport*.test.js",
    "pretest:integration": "node ../scripts/build.mjs core node",
    "test:integration": "node --test dist/test/cross.test.js dist/test/integration.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@uniconn/core": "0.1.0",
    "ws": "^8.18.0",
    "kcpjs": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
